#  Wholesale-ignore PDF files as well as gzip-compressed files
*.gz
*.pdf

#  Ignore root '__init__.py'
/__init__.py

#  Ignore everything in 'docs/img/', 'docs/xml/', and 'tmp/'
docs/img/
docs/xml/
tmp/

#  Ignore generated Python bytecode under maintained roots
/.pytest_cache/
src/**/__pycache__/
src/**/*.py[cod]
dev/**/__pycache__/
dev/**/*.py[cod]
tests/**/__pycache__/
tests/**/*.py[cod]

#  Keep generated outputs in one repository-root artifact boundary
/artifacts/*
!/artifacts/README.md

#  Ignore everything in 'data/{genomes,processed,raw,symlinked,tracks}/'
data/genomes/
data/processed/
data/symlinked/
data/tracks/

#  Re-allow certain files in 'data/raw/docs/', continuing to exclude other
#+ files
data/raw/*
!data/raw/docs/
data/raw/docs/*
!data/raw/docs/measurements_siqchip.tsv
!data/raw/docs/measurements_siqchip_initial.tsv
!data/raw/docs/measurements_siqchip_PRJNA857063.tsv
!data/raw/docs/parse_metadata_siqchip.yml
!data/raw/docs/parse_metadata_siqchip_PRJNA857063.yml
!data/raw/docs/parse_metadata_siqchip_reference.md
!data/raw/docs/parse_metadata_siqchip_strict.yml
data/raw/docs/measurements_siqchip_all.tsv
data/raw/docs/SRR_custom.tsv
data/raw/docs/test*

#  Re-allow everything in the 'tables/' subdirectory under
#+ 'data/processed/compute_signal/' for Bio-protocol manuscript-specific
#+ alignment and filtering parameters
!data/processed/
data/processed/*
!data/processed/compute_signal/
data/processed/compute_signal/*
!data/processed/compute_signal/bowtie2_global_flag-2_mapq-1/
data/processed/compute_signal/bowtie2_global_flag-2_mapq-1/*
!data/processed/compute_signal/bowtie2_global_flag-2_mapq-1/tables/

#  Ignore generated test fixture outputs in 'tests/' but retain fixture docs
tests/fixtures/ai_attribution/**
!tests/fixtures/ai_attribution/
!tests/fixtures/ai_attribution/README.md
!tests/fixtures/ai_attribution/make.sh

tests/fixtures/align_fastqs/**
!tests/fixtures/align_fastqs/
