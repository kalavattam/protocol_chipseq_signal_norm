#  Wholesale-ignore PDF files as well as gzip-compressed files
*.gz
*.pdf

#  Ignore root '__init__.py'
/__init__.py

#  Ignore everything in 'analysis/', 'docs/dev/', 'docs/img/', 'docs/xml/',
#+ 'scraps/' (where temporary scratch work is stored), and 'tmp/'
analysis/
docs/dev/
docs/img/
docs/xml/
scraps/
tmp/

#  Ignore specific directories under 'scripts/'
scripts/__pycache__/
scripts/blog/
scripts/functions/__pycache__/

#  Ignore everything in 'data/{genomes,processed,raw,symlinked,tracks}/'
data/genomes/
data/processed/
data/symlinked/
data/tracks/

#  Re-allow certain files in 'data/raw/docs/', continuing to exclude other
#+ files
data/raw/*
!data/raw/docs/
data/raw/docs/*
!data/raw/docs/measurements_siqchip.tsv
!data/raw/docs/measurements_siqchip_initial.tsv
!data/raw/docs/parse_metadata_siqchip.yml
data/raw/docs/measurements_siqchip_all.tsv
data/raw/docs/SRR_custom.tsv
data/raw/docs/test*

#  Re-allow everything in the 'tables/' subdirectory under
#+ 'data/processed/compute_signal/' for Bio-protocol manuscript-specific
#+ alignment and filtering parameters
!data/processed/
data/processed/*
!data/processed/compute_signal/
data/processed/compute_signal/*
!data/processed/compute_signal/bowtie2_global_flag-2_mapq-1/
data/processed/compute_signal/bowtie2_global_flag-2_mapq-1/*
!data/processed/compute_signal/bowtie2_global_flag-2_mapq-1/tables/

#  Ignore generated test fixture outputs in 'tests/'; however, retain
#+ hand-written fixture docs
tests/align_fastqs/fixtures/**
!tests/align_fastqs/fixtures/
!tests/align_fastqs/fixtures/README.md

tests/calculate_scaling_factor/fixtures/**
!tests/calculate_scaling_factor/fixtures/
!tests/calculate_scaling_factor/fixtures/README.md

tests/compute_signal/fixtures/**
!tests/compute_signal/fixtures/
!tests/compute_signal/fixtures/README.md

tests/download_fastqs/fixtures/**
!tests/download_fastqs/fixtures/
!tests/download_fastqs/fixtures/README.md

tests/filter_alignments/fixtures/**
!tests/filter_alignments/fixtures/
!tests/filter_alignments/fixtures/README.md

tests/trim_fastqs/fixtures/**
!tests/trim_fastqs/fixtures/
!tests/trim_fastqs/fixtures/README.md

#  Ignore generated smoke-test output
tests/outputs/
