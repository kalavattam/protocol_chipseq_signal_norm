{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "numeric_emission_inventory.schema.json",
  "title": "Bounded static numeric emission inventory",
  "type": "object",
  "required": [
    "schema_version",
    "inventory_scope",
    "sites",
    "review_candidates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "inventory_scope": {
      "type": "object",
      "required": [
        "claim",
        "python_syntactic_classes",
        "shell_syntactic_classes",
        "unsupported_constructs"
      ],
      "properties": {
        "claim": {
          "const": "complete_only_within_recognized_static_syntactic_classes"
        },
        "python_syntactic_classes": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "shell_syntactic_classes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "unsupported_constructs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "sites": {
      "type": "array",
      "items": {"$ref": "#/$defs/site"}
    },
    "review_candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewCandidate"}
    }
  },
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "site_id",
        "fingerprint",
        "language",
        "path",
        "line",
        "column",
        "symbol",
        "syntactic_class",
        "source_expression",
        "value_source",
        "dp_source",
        "dependencies",
        "portability",
        "nonfinite_reachability",
        "applicability",
        "exception",
        "review_status"
      ],
      "properties": {
        "site_id": {"type": "string", "minLength": 1},
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "language": {"enum": ["python", "shell"]},
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 0},
        "symbol": {"type": "string", "minLength": 1},
        "syntactic_class": {"type": "string", "minLength": 1},
        "source_expression": {"type": "string"},
        "value_source": {"type": "string"},
        "dp_source": {"type": "string"},
        "dependencies": {
          "type": "array",
          "items": {"type": "string"}
        },
        "portability": {"type": "string"},
        "nonfinite_reachability": {
          "enum": ["unknown", "statically_guarded", "statically_possible"]
        },
        "applicability": {"const": "unresolved"},
        "exception": {"const": "unresolved"},
        "review_status": {"const": "evidence_only"}
      }
    },
    "site": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["numeric_relevance", "formatting_evidence"],
          "properties": {
            "numeric_relevance": {
              "enum": ["candidate", "not_statically_apparent"]
            },
            "formatting_evidence": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "reviewCandidate": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["unsupported_reason"],
          "properties": {
            "unsupported_reason": {"type": "string", "minLength": 1}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "additionalProperties": false
}
